# Agent Loop Configuration Example
# Copy this file to ~/.config/agent-loop/.env or to your project root as .env

# ==========================================
# AI Provider Configuration
# ==========================================

# Choose AI provider: anthropic or openai
AI_PROVIDER=anthropic

# Model temperature (0.0 = deterministic, 2.0 = very creative)
AI_TEMPERATURE=0.7

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514  # Optional, defaults to claude-3-7-sonnet-latest

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o  # Optional, defaults to gpt-4o

# ==========================================
# Agent Loop Control
# ==========================================

# Maximum number of agent thinking cycles before stopping
# Prevents runaway loops and excessive token usage
# Can be overridden with --max-iterations CLI flag
MAX_ITERATIONS=20

# Whether to prompt user when task completion is detected
# If true: asks user to confirm before stopping when completion detected
# If false: automatically stops when completion detected
# Can be disabled with --no-prompt-on-completion CLI flag
PROMPT_ON_COMPLETION=true

# ==========================================
# Optional Tool Integrations
# ==========================================

# Jira Integration (Optional)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token

# Confluence Integration (Optional)
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net
CONFLUENCE_EMAIL=your_email@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token
